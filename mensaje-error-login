defined('ABSPATH') or die('Parece que no tienes permiso para acceder...');

function lgwp_custom_login_errors() {
    // Mensaje genérico sanitizado y preparado para traducción
    return esc_html__( 'ERROR: Credenciales de acceso incorrectas', 'login-guardianeswp' );
}

// Filtro con prioridad alta para evitar que otros plugins lo sobrescriban
add_filter( 'login_errors', 'lgwp_custom_login_errors', 999 );
